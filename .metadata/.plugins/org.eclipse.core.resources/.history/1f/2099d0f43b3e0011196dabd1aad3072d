<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Update Student</title>
</head>
<body>

<h1>Update Student Info</h1>

<form action="/studentportal/save" method="post">
Id : <input type="hidden" name="id" th:value=${update.id}>
Name : <input type="text" placeholder="Enter Name " name="name" required th:value=${update.name}> <br> <br>
Roll No : <input type="number" placeholder="Enter Roll No" name ="rollno" required th:value=${update.rollno}> <br> <br>
Gender : <input type="radio" name="gender" value="male">Male
 <input type="radio" name="gender" value="female">Female
 <input type="radio" name="gender" value="Others">Others <br> <br>
 City : <select name="city">
 <option value="pune">Pune</option>
 <option value="mumbai">Mumbai</option>
 <option value="delhi">Delhi</option>
 <option value="kolhapur">Kolhapur</option>
 <option value="sangli">Sangli</option>
 </select> <br> <br>
 <input type="submit">
</form>

</body>
</html>