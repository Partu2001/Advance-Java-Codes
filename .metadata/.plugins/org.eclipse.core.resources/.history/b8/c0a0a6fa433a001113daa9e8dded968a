package com.java.app;

import org.springframework.context.ApplicationContext;
import org.springframework.context.annotation.AnnotationConfigApplicationContext;

import com.java.daointerface.GiftHibernateInterface;
import com.java.entity.HibernateGift;

public class MainGiftHibernate {
	
	public static void main(String[] args) {
		

	ApplicationContext app=new AnnotationConfigApplicationContext("com");
	GiftHibernateInterface hi=app.getBean(GiftHibernateInterface.class);
	
	
	HibernateGift hg=new HibernateGift();
	hg.setGiftName("Teddy1");
	hg.setCategory("Medium1");
	hg.setPrice(400);
	hg.setGiftId(52);
	//hi.addGift(hg);

	hi.updateGift(hg);
	
	}

}
